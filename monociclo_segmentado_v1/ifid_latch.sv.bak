import	lagarto0_pkg::*;

module IFID_Latch (
	input									clk_i,
	input									rst_ni,
	input			[ISA_SIZE-1:0]		inst_i,
	input			[VADD_SIZE-1:0]	pc_i,
	output reg	[ISA_SIZE-1:0]		inst_o,
	output reg	[VADD_SIZE-1:0]	pc_o,
	
);

	always @(posedge clk_i, negedge rst_ni)
	begin
		if (!rst_ni)
			begin
				inst_o <= {ISA_SIZE{1'b0}};
				pc_o <= {VADD_SIZE{1'b0}};
			end
		else
			begin
				inst_o <= inst_i;
				pc_o <= pc_i;
			end
	end
endmodule
